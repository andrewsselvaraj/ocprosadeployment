<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent POM for the M2ITS Online Exam microservices.
        Spring Boot 4.0.x is paired with Spring Cloud 2025.1.x (the release train built for it).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>com.m2its</groupId>
    <artifactId>m2its-exam-platform</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>M2ITS Online Exam Platform</name>

    <modules>
        <module>common-lib</module>
        <module>identity-service</module>
        <module>academic-service</module>
        <module>question-service</module>
        <module>exam-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <springdoc.version>3.0.3</springdoc.version>
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>

        <!-- Container image settings, overridable from the command line / CI:
             mvnw -Pjib package -Dimage.registry=quay.io/myorg -Dimage.tag=1.0.0 -->
        <image.registry>quay.io/your-org</image.registry>
        <image.tag>${project.version}</image.tag>
        <image.base>registry.access.redhat.com/ubi9/openjdk-17-runtime:latest</image.base>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.m2its</groupId>
                <artifactId>common-lib</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.m2its</groupId>
                <artifactId>common-lib</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <!-- Layered jar: dependencies and app classes become separate Docker layers -->
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                    </configuration>
                    <executions>
                        <execution>
                            <goals>
                                <!-- Writes META-INF/build-info.properties, shown by /actuator/info -->
                                <goal>build-info</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <from>
                            <image>${image.base}</image>
                        </from>
                        <to>
                            <image>${image.registry}/${project.artifactId}:${image.tag}</image>
                        </to>
                        <container>
                            <!-- OpenShift runs containers with an arbitrary non-root UID in group 0 -->
                            <user>185</user>
                            <jvmFlags>
                                <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                                <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                            </jvmFlags>
                            <creationTime>USE_CURRENT_TIMESTAMP</creationTime>
                        </container>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Load Mockito as a Java agent instead of letting it self-attach at runtime
                 (dynamic agent loading is restricted on recent JDKs and fails in some environments). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Bounded heap: predictable memory use on laptops and CI runners -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off -Xmx512m -XX:+UseSerialGC</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Build and push images without a Docker daemon: mvnw -Pjib package -->
        <profile>
            <id>jib</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.google.cloud.tools</groupId>
                        <artifactId>jib-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
